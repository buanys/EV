    {
      "name": "BACKGROUND",
      "enforcement": "enforced",
      "services": [
        "host/background"
      ],
      "androidPermissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS"
      ]
    },
    {
      "name": "SECRETS",
      "enforcement": "enforced",
