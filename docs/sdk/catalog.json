        "launch",
        "currentApp",
        "status",
        "clipboard",
        "setClipboard",
        "notify",
        "notifications",
        "canReadNotifications",
        "openNotificationAccess"
      ]
    },
    {
      "key": "host/screen",
      "interface": "ScreenService",
      "delivery": "rootContext",
      "permission": null,
      "impl": "ScreenServiceImpl",
      "capabilities": [
        "dump",
        "tap",
        "tapText",
        "input",
        "swipe",
        "key",
        "currentPackage",
        "openSettings"
