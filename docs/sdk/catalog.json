        "read",
        "write",
        "erase"
      ]
    },
    {
      "key": "host/calendar",
      "interface": "CalendarService",
      "delivery": "declared",
      "permission": "CALENDAR",
      "impl": "CalendarServiceImpl",
      "capabilities": [
        "calendars",
        "events",
        "event",
        "create",
        "createAll",
        "update",
        "delete"
      ]
    },
    {
      "key": "host/device-control",
      "interface": "DeviceControlService",
      "delivery": "declared",
      "permission": "DEVICE_CONTROL",
      "impl": "DeviceControlServiceImpl",
      "capabilities": [
        "state",
        "setState",
        "display",
        "setBrightness",
        "setScreenTimeout",
        "sound",
        "setVolume",
        "setRingMode",
        "setDoNotDisturb",
        "flashlight",
        "setFlashlight",
        "media"
