      "impl": "ContactsServiceImpl",
      "capabilities": [
        "search",
        "read"
      ],
      "readOnly": true
    },
    {
      "key": "host/sms",
      "interface": "SmsService",
      "delivery": "declared",
      "permission": "SMS",
      "impl": "SmsServiceImpl",
      "capabilities": [
