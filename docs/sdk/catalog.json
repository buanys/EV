    },
    {
      "key": "host/theme-catalog",
      "interface": "ThemeCatalogService",
      "delivery": "serviceDirectory",
      "permission": null,
      "impl": "HostThemeCatalog",
      "capabilities": [
        "themes",
        "available",
        "resolve"
      ]
    },
    {
      "key": "host/plugin-catalog",
      "interface": "PluginCatalogService",
      "delivery": "serviceDirectory",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
        "manifests",
        "manifestOf",
        "readSetting",
        "writeSetting"
      ]
    },
    {
      "key": "host/plugin-manager",
      "interface": "PluginManagerService",
      "delivery": "serviceDirectory",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
