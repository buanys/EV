{
  "$comment": "宿主能力面机器可读清单。与 host-services.md 同源，改一处必须改两处。生成日期 2026-11-10。",
  "schemaVersion": 1,
  "host": {
    "packageName": "ev.buan",
    "repository": "buanys/EV",
    "apiVersion": {
      "pluginApi": 1,
      "note": "实验期整数等值门；正式版改为 hostApi 语义化范围，见 versioning.md"
    }
  },
  "delivery": {
    "rootContext": "cordis.provide，全员可见，无权限门",
    "serviceDirectory": "ServiceDirectory.publish，需 lookup，缺失不导致启动失败",
    "declared": "provide*IfDeclared，声明 HostPermission 且授权才有绑定",
    "pluginProvided": "由插件在 apply 里 publish"
  },
  "services": [
    {
      "key": "host/appearance",
      "interface": "AppearanceService",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
        "update"
      ]
    },
    {
      "key": "host/navigation",
      "interface": "HostNavigation",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
        "openPluginManager",
        "openSettings"
      ]
    },
    {
      "key": "host/page-reader",
      "interface": "PageReader",
      "delivery": "rootContext,serviceDirectory",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
        "render"
      ]
    },
    {
      "key": "host/service-directory",
      "interface": "ServiceDirectory",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HostComposition",
      "capabilities": [
        "publish",
        "lookup",
        "retract"
      ]
    },
    {
      "key": "host/plugin-install",
      "interface": "PluginInstallService",
