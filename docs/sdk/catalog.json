    {
      "key": "host/hud",
      "interface": "HudService",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HudServiceImpl",
      "capabilities": [
        "show",
        "pulse",
        "attachController",
        "hide",
        "onTogglePause",
        "onStop"
      ]
    },
    {
      "key": "host/restart",
      "interface": "HostRestart",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HostRestartImpl",
      "capabilities": [
        "restart"
      ]
    },
    {
      "key": "host/permission",
      "interface": "PermissionService",
      "delivery": "rootContext",
      "permission": null,
      "impl": "HostActivation",
      "capabilities": [
        "isGranted",
        "require"
      ]
    },
    {
      "key": "host/background",
      "interface": "BackgroundService",
      "delivery": "rootContext",
      "permission": "BACKGROUND",
      "impl": "EvBackgroundService",
      "capabilities": [
        "acquire",
        "release"
      ]
    },
    {
      "key": "host/runtime-budget",
      "interface": "RuntimeBudgetService",
      "delivery": "rootContext",
      "permission": null,
