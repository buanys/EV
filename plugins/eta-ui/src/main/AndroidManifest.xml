<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="cordis.entry"
            android:value="ev.buan.plugins.eta.ui.EtaUiPlugin" />
        <meta-data
            android:name="cordis.api"
            android:value="1" />
        <!-- PLUGIN_STORAGE: the chat history file (sessions.json) in this plugin's own area. -->
        <meta-data
            android:name="cordis.permissions"
            android:value="PLUGIN_STORAGE" />
        <!-- The chat page consumes the AgentService contract; the brain plugin may be absent. -->
        <meta-data
            android:name="cordis.dependencies"
            android:value="[&quot;ev.buan.plugins.agent.api&quot;]" />
    </application>
</manifest>
