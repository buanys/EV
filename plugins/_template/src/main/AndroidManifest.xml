<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      cordis.entry 是加载器找入口类的依据，必须与 sidecar 的 entryClass 一致。
      cordis.api 是插件契约版本；apiVersion 不匹配的容器会被拒绝而不是崩溃。
    -->
    <application>
        <meta-data
            android:name="cordis.entry"
            android:value="ev.buan.plugins.template.TemplatePlugin" />
        <meta-data
            android:name="cordis.api"
            android:value="1" />
    </application>

</manifest>
