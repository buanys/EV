<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：模型调用、网页搜索与抓取。以前只有依赖库的 manifest 合并进来这一条，
         宿主自己没声明——那个库一换，网络就会静默失效。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 设备状态里的网络类型：没有这条，ConnectivityManager 会抛 SecurityException，
         工具只能报 unknown——那会让模型以为手机没网。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 后台运行：Android 13+ 通知需要运行时授权；Android 14+ 前台服务必须声明类型与类型权限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- API 30+ 的包可见性：不声明这一条，queryIntentActivities 会把可启动应用过滤成空。
         只声明"要查启动器意图"，不用 QUERY_ALL_PACKAGES 那种全量权限。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".EvApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="EV"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 插件后台任务的宿主前台服务。specialUse 是 Android 14+ 对「用途由应用自定」的
             类型，必须同时给出 PROPERTY_SPECIAL_USE_FGS_SUBTYPE。 -->
        <service
            android:name=".EvBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="plugin-background-work" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="EV"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="EV"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PluginsActivity"
            android:exported="false"
            android:label="EV"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PluginPageActivity"
            android:exported="false"
            android:label="EV"
            android:windowSoftInputMode="adjustResize" />

        <!-- 通知读取：用户必须在 设置 → 通知 → 通知使用权 里手动授权，
             这是系统级单独授权，不是运行时权限。授权前 notify_list 一律读不到。 -->
        <service
            android:name=".EvNotificationListener"
            android:label="EV 通知读取"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 无障碍：agent 的"眼睛和手"。用户必须在 设置 → 无障碍 里手动开启，
             开启后本服务能读到任何界面的文字、能在任何应用里点按输入。
             权限如此之大，所以服务本身不做任何决定——是否允许调用由宿主的审批门把关。 -->
        <service
            android:name=".EvAccessibilityService"
            android:exported="true"
            android:label="EV 屏幕操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ev_accessibility" />
        </service>
    </application>

</manifest>
