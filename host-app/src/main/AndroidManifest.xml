<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：模型调用、网页搜索与抓取。以前只有依赖库的 manifest 合并进来这一条，
         宿主自己没声明——那个库一换，网络就会静默失效。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 设备状态里的网络类型：没有这条，ConnectivityManager 会抛 SecurityException，
         工具只能报 unknown——那会让模型以为手机没网。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 后台运行：Android 13+ 通知需要运行时授权；Android 14+ 前台服务必须声明类型与类型权限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ==== 安装即得：不弹窗，装完就能用 ==== -->

    <!-- 全量包可见性。之前只用 <queries> 声明"要查启动器意图"就够 app_list 用，
         但那只能看到有启动器入口的应用：系统服务、后台常驻的、被禁用的入口全都看不见。
         agent 说"打开设置里的显示"时，找不到目标就无从下手。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 后台任务不被系统睡掉；配合 RECEIVE_BOOT_COMPLETED，定时触发才可能在灭屏后发生。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 网络与近场：Wi-Fi / 蓝牙 / NFC 的状态读取与切换。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 直接拉通知栏、换壁纸：现在这两件事都要靠无障碍模拟手势。 -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- ==== 运行时：用户会看到弹窗，逐项授权 ==== -->

    <!-- 只读的个人数据。agent 回答"谁发的""今天有什么会"靠这些；
         刻意不申请写权限——能读和能改是两回事，写坏了用户不会知道。 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 多模态输入：看图、听声音。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13+ 的媒体库索引：按类型检索相册 / 视频 / 音频，
         而不是只知道一个绝对路径。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- ==== 特殊权限：要在设置页单独开，或在 adb 里授予 ==== -->

    <!-- 使用情况访问：比无障碍事件流更可靠的"当前应用"来源。
         今天那个"app_current 返回速览"的问题，根子就是只有事件流一条路。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 精确定时：走走停停的定时任务靠它，否则灭屏后 Handler 会失联。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 直接安装 APK：forge 编出来的插件不用再手动拷进 mods。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 切勿扰 / 切换铃音模式。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 硬件标成可选：没有摄像头/麦克风/NFC 的设备也该能装，
         否则某些平板和精简版 ROM 上会直接装不上。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- API 30+ 的包可见性：不声明这一条，queryIntentActivities 会把可启动应用过滤成空。
         现在虽然已经有了 QUERY_ALL_PACKAGES，这段保留着也没坏处：它声明的是"意图"，
         在降级到旧系统或某些厂商 ROM 上更稳。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".EvApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="EV"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 插件后台任务的宿主前台服务。specialUse 是 Android 14+ 对「用途由应用自定」的
             类型，必须同时给出 PROPERTY_SPECIAL_USE_FGS_SUBTYPE。 -->
        <service
            android:name=".EvBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="plugin-background-work" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="EV"
            android:theme="@style/Theme.EV.Startup"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="EV"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PluginsActivity"
            android:exported="false"
            android:label="EV"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PluginPageActivity"
            android:exported="false"
            android:label="EV"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 通知读取：用户必须在 设置 → 通知 → 通知使用权 里手动授权，
             这是系统级单独授权，不是运行时权限。授权前 notify_list 一律读不到。 -->
        <service
            android:name=".EvNotificationListener"
            android:label="EV 通知读取"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 无障碍：agent 的"眼睛和手"。用户必须在 设置 → 无障碍 里手动开启，
             开启后本服务能读到任何界面的文字、能在任何应用里点按输入。
             权限如此之大，所以服务本身不做任何决定——是否允许调用由宿主的审批门把关。 -->
        <service
            android:name=".EvAccessibilityService"
            android:exported="true"
            android:label="EV 屏幕操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ev_accessibility" />
        </service>
    </application>

</manifest>
